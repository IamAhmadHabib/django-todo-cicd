pipeline {
  agent any

  stages {

    stage('Code Checkout') {
      steps {
        checkout scm
        echo 'Code checked out successfully.'
      }
    }

    stage('Build') {
      agent {
        docker { image 'python:3.9-slim' }
      }
      steps {
        sh 'python3 manage.py check'
        echo 'Django check passed. Build stage complete.'
      }
    }

    stage('Deploy') {
      when {
        branch 'develop'
      }
      steps {
        echo 'Deploying two containers...'

        sh 'docker rm -f todo_container1 || true'
        sh 'docker rm -f todo_container2 || true'

        sh 'docker build -t todo .'

        sh 'docker run -d -p 8000:8000 --name todo_container1 todo'
        sh 'docker run -d -p 8001:8000 --name todo_container2 todo'

        echo 'Both containers are running.'
        sh 'docker ps | grep todo_container'

        sleep 30

        echo 'Stopping and removing containers...'
        sh 'docker stop todo_container1 todo_container2'
        sh 'docker rm todo_container1 todo_container2'
        echo 'Containers stopped and removed.'
      }
    }

  }

  post {
    success {
      echo 'Pipeline executed successfully'
    }
    failure {
      echo 'Pipeline execution failed'
    }
    always {
      echo 'Pipeline execution completed'
    }
  }

}
